      "terms": {
        "title": "شروط الخدمة",
        "lastUpdated": "آخر تحديث: يناير 2024",
        "acceptance": {
          "title": "1. قبول الشروط",
          "content": "من خلال الوصول واستخدام تطبيق العيادة هذا، فإنك تقبل وتوافق على الالتزام بشروط وأحكام هذه الاتفاقية."
        },
        "services": {
          "title": "2. استخدام الخدمات",
          "content": "يوفر هذا التطبيق خدمات حجز المواعيد الطبية وإدارة السجلات الصحية. توافق على استخدام هذه الخدمات فقط للأغراض القانونية ووفقاً لهذه الشروط."
        },
        "userAccount": {
          "title": "3. حساب المستخدم",
          "content": "أنت مسؤول عن الحفاظ على سرية حسابك وكلمة المرور. توافق على تحمل المسؤولية عن جميع الأنشطة التي تحدث تحت حسابك."
        },
        "medicalInfo": {
          "title": "4. المعلومات الطبية",
          "content": "جميع المعلومات الطبية المقدمة من خلال هذا التطبيق سرية ومحمية بموجب قوانين الخصوصية المعمول بها. نحن ملتزمون بالحفاظ على خصوصية وأمان معلوماتك الصحية."
        },
        "appointments": {
          "title": "5. المواعيد",
          "content": "حجز المواعيد يخضع لتوفر الطبيب. يجب إلغاء المواعيد قبل 24 ساعة على الأقل. عدم الحضور قد يؤدي إلى رسوم."
        },
        "liability": {
          "title": "6. تحديد المسؤولية",
          "content": "هذا التطبيق هو أداة لتسهيل المواعيد الطبية وحفظ السجلات. لا يحل محل الاستشارة الطبية المهنية أو التشخيص أو العلاج."
        },
        "termination": {
          "title": "7. الإنهاء",
          "content": "نحتفظ بالحق في إنهاء أو تعليق حسابك في أي وقت لانتهاك هذه الشروط أو لأي سبب آخر نراه ضرورياً."
        },
        "changes": {
          "title": "8. تغييرات الشروط",
          "content": "نحتفظ بالحق في تعديل هذه الشروط في أي وقت. ستكون التغييرات سارية فور نشرها في التطبيق."
        },
        "contact": {
          "title": "9. معلومات الاتصال",
          "content": "إذا كان لديك أي أسئلة حول شروط الخدمة هذه، يرجى الاتصال بنا على support@clinicapp.com."
        }
      },
      "privacy": {
        "title": "سياسة الخصوصية",
        "lastUpdated": "آخر تحديث: يناير 2024",
        "introduction": {
          "title": "1. مقدمة",
          "content": "تصف سياسة الخصوصية هذه كيفية جمع واستخدام وحماية معلوماتك الشخصية والطبية عند استخدام تطبيق العيادة الخاص بنا."
        },
        "dataCollection": {
          "title": "2. المعلومات التي نجمعها",
          "content": "نجمع المعلومات الشخصية مثل الاسم وتفاصيل الاتصال والتاريخ الطبي وبيانات المواعيد لتقديم خدماتنا بفعالية."
        },
        "dataUsage": {
          "title": "3. كيف نستخدم معلوماتك",
          "content": "تُستخدم معلوماتك لجدولة المواعيد والاحتفاظ بالسجلات الطبية والتواصل مع مقدمي الرعاية الصحية وتحسين خدماتنا."
        },
        "dataSharing": {
          "title": "4. مشاركة المعلومات",
          "content": "لا نبيع أو نؤجر معلوماتك الشخصية. تتم مشاركة المعلومات الطبية فقط مع مقدمي الرعاية الصحية المخولين المشاركين في رعايتك."
        },
        "dataSecurity": {
          "title": "5. أمان البيانات",
          "content": "نطبق تدابير أمنية معيارية في الصناعة لحماية معلوماتك، بما في ذلك التشفير والخوادم الآمنة وضوابط الوصول."
        },
        "userRights": {
          "title": "6. حقوقك",
          "content": "لديك الحق في الوصول إلى معلوماتك الشخصية أو تحديثها أو حذفها. يمكنك أيضاً طلب نسخة من بياناتك أو تقييد معالجتها."
        },
        "cookies": {
          "title": "7. ملفات تعريف الارتباط والتتبع",
          "content": "نستخدم ملفات تعريف الارتباط والتقنيات المماثلة لتحسين تجربة المستخدم وتحليل أنماط الاستخدام والحفاظ على أمان الجلسة."
        },
        "thirdParty": {
          "title": "8. خدمات الطرف الثالث",
          "content": "قد يتكامل تطبيقنا مع خدمات الطرف الثالث للحصول على وظائف محسنة. هذه الخدمات لها سياسات خصوصية خاصة بها."
        },
        "children": {
          "title": "9. خصوصية الأطفال",
          "content": "خدماتنا غير مخصصة للأطفال دون سن 13 عاماً. لا نجمع عن قصد معلومات شخصية من الأطفال دون سن 13 عاماً."
        },
        "changes": {
          "title": "10. تغييرات السياسة",
          "content": "قد نحدث سياسة الخصوصية هذه بشكل دوري. سنخطرك بالتغييرات المهمة من خلال التطبيق أو البريد الإلكتروني."
        },
        "contact": {
          "title": "11. اتصل بنا",
          "content": "إذا كان لديك أسئلة حول سياسة الخصوصية هذه أو بياناتك، يرجى الاتصال بنا على privacy@clinicapp.com."
        }
      }
    },
